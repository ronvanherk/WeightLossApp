# Local development: a Postgres you run yourself (`docker compose up db` works too).
DATABASE_URL="postgresql://weightloss:weightloss@localhost:5434/weightloss"
# 32+ random chars; signs the app's bearer tokens. openssl rand -base64 48
AUTH_SECRET=""
# Open Food Facts asks clients to identify themselves: "AppName/version (contact)".
OFF_USER_AGENT="WeightLossApp/0.1"
