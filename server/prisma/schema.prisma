generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY // desk job, little exercise
  LIGHT // 1-3 workouts a week
  MODERATE // 3-5 workouts a week
  ACTIVE // 6-7 workouts a week
  VERY_ACTIVE // physical job + training
}

enum Meal {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// Where a food row came from. Official tables are re-importable by (source, sourceId).
enum FoodSource {
  NEVO // NL, RIVM
  FRIDA // DK, DTU Fødevareinstituttet
  BLS // DE, Max Rubner-Institut
  OFF // Open Food Facts (branded products, barcodes)
  CUSTOM // created by one of the users, visible to all users
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  name         String
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")
  profile      Profile?
  diary        DiaryEntry[]
  weights      WeightEntry[]
  foods        Food[]

  @@map("app_user")
}

model Profile {
  userId       Int           @id @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex          Sex
  birthDate    DateTime      @map("birth_date") @db.Date
  heightCm     Float         @map("height_cm")
  activity     ActivityLevel @default(LIGHT)
  goalWeightKg Float         @map("goal_weight_kg")
  // Planned loss per week; 0 = maintain.
  weeklyLossKg Float         @default(0.5) @map("weekly_loss_kg")
  // UI language and the preferred language for food names: nl, da, de.
  locale       String        @default("nl")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("profile")
}

// All nutrient values are per 100 g (or 100 ml for drinks).
model Food {
  id          Int          @id @default(autoincrement())
  source      FoodSource
  sourceId    String       @map("source_id")
  barcode     String?
  nameNl      String?      @map("name_nl")
  nameDa      String?      @map("name_da")
  nameDe      String?      @map("name_de")
  nameEn      String?      @map("name_en")
  brand       String?
  kcal        Float
  protein     Float?
  carbs       Float?
  fat         Float?
  fiber       Float?
  sugar       Float?
  salt        Float?
  // Typical portion in grams, when the source knows one.
  servingG    Float?       @map("serving_g")
  // Lower-cased names + brand in all languages; trigram-indexed (see migration).
  searchText  String       @map("search_text")
  createdById Int?         @map("created_by_id")
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime     @updatedAt @map("updated_at")
  diary       DiaryEntry[]

  @@unique([source, sourceId])
  @@index([barcode])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "food_search_text_trgm_idx")
  @@map("food")
}

model DiaryEntry {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  meal      Meal
  foodId    Int      @map("food_id")
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)
  grams     Float
  // Snapshot at logging time, so a re-import of the food table never rewrites history.
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("diary_entry")
}

model WeightEntry {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  weightKg Float    @map("weight_kg")

  @@unique([userId, date])
  @@map("weight_entry")
}
