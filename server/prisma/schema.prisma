generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY // desk job, little exercise
  LIGHT // 1-3 workouts a week
  MODERATE // 3-5 workouts a week
  ACTIVE // 6-7 workouts a week
  VERY_ACTIVE // physical job + training
}

enum Meal {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// Where a food row came from. Official tables are re-importable by (source, sourceId).
enum FoodSource {
  NEVO // NL, RIVM
  FRIDA // DK, DTU Fødevareinstituttet
  BLS // DE, Max Rubner-Institut
  OFF // Open Food Facts (branded products, barcodes)
  CUSTOM // created by one of the users, visible to all users
  RECIPE // made of other foods by one of the users, visible to all users
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  name         String
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")
  profile      Profile?
  diary        DiaryEntry[]
  weights      WeightEntry[]
  foods        Food[]
  water        WaterEntry[]
  favorites    Favorite[]
  fasts        Fast[]
  steps        DailySteps[]
  savedMeals   SavedMeal[]
  // Users with the same household id can put meals in each other's diary. Set with user:household.
  householdId  Int?          @map("household_id")

  @@map("app_user")
}

model Profile {
  userId       Int           @id @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex          Sex
  birthDate    DateTime      @map("birth_date") @db.Date
  heightCm     Float         @map("height_cm")
  activity     ActivityLevel @default(LIGHT)
  goalWeightKg Float         @map("goal_weight_kg")
  // Planned loss per week; 0 = maintain.
  weeklyLossKg Float         @default(0.5) @map("weekly_loss_kg")
  // UI language and the preferred language for food names: nl, da, de.
  locale       String        @default("nl")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("profile")
}

// All nutrient values are per 100 g (or 100 ml for drinks).
model Food {
  id          Int          @id @default(autoincrement())
  source      FoodSource
  sourceId    String       @map("source_id")
  barcode     String?
  nameNl      String?      @map("name_nl")
  nameDa      String?      @map("name_da")
  nameDe      String?      @map("name_de")
  nameEn      String?      @map("name_en")
  brand       String?
  kcal        Float
  protein     Float?
  carbs       Float?
  fat         Float?
  fiber       Float?
  sugar       Float?
  salt        Float?
  saturatedFat Float?      @map("saturated_fat")
  // Typical portion in grams, when the source knows one.
  servingG    Float?       @map("serving_g")
  // "g" or "ml": what the per-100 values are per.
  unit        String       @default("g")
  // Food group: Dutch for NEVO ("Groente"), English for Frida/BLS, "Recept"; null for branded products.
  category    String?
  // Every nutrient the source has, by NEVO component code (ENERCC, VITC, FE, ...), per 100 g.
  nutrients   Json?
  // Source extras: synonyms, remark, traces, fortification.
  details     Json?
  // Lower-cased names + brand in all languages; trigram-indexed (see migration).
  searchText  String       @map("search_text")
  createdById Int?         @map("created_by_id")
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  updatedAt   DateTime     @updatedAt @map("updated_at")
  diary       DiaryEntry[]
  ingredients FoodIngredient[] @relation("recipe")
  usedIn      FoodIngredient[] @relation("ingredient")
  favoriteOf  Favorite[]

  @@unique([source, sourceId])
  @@index([barcode])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "food_search_text_trgm_idx")
  @@map("food")
}

model DiaryEntry {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  meal      Meal
  // Null for a quick entry: kcal (and maybe macros) typed in, with only a name; grams is 0 then.
  foodId    Int?     @map("food_id")
  food      Food?    @relation(fields: [foodId], references: [id], onDelete: Restrict)
  name      String?
  grams     Float
  // Snapshot at logging time, so a re-import of the food table never rewrites history.
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  // Null when the food (or the quick entry) does not say.
  fiber        Float?
  sugar        Float?
  saturatedFat Float?  @map("saturated_fat")
  salt         Float?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, date])
  @@map("diary_entry")
}

model WeightEntry {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  weightKg Float    @map("weight_kg")

  @@unique([userId, date])
  @@map("weight_entry")
}

// A nutrient as NEVO defines it; the keys of Food.nutrients.
model Nutrient {
  code      String @id
  groupNl   String @map("group_nl")
  groupEn   String @map("group_en")
  nameNl    String @map("name_nl")
  nameEn    String @map("name_en")
  unit      String
  sortOrder Int    @map("sort_order")

  @@map("nutrient")
}

// What a composite food is made of (NEVO recipes): `share` percent of the recipe's weight.
model FoodIngredient {
  foodId       Int   @map("food_id")
  food         Food  @relation("recipe", fields: [foodId], references: [id], onDelete: Cascade)
  ingredientId Int   @map("ingredient_id")
  ingredient   Food  @relation("ingredient", fields: [ingredientId], references: [id], onDelete: Cascade)
  share        Float

  @@id([foodId, ingredientId])
  @@map("food_ingredient")
}

// Water drunk on a day, in ml; one row per user and day.
model WaterEntry {
  id     Int      @id @default(autoincrement())
  userId Int      @map("user_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  ml     Int

  @@unique([userId, date])
  @@map("water_entry")
}

model Favorite {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    Int      @map("food_id")
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, foodId])
  @@map("favorite")
}

// An intermittent fast: open while endedAt is null; at most one open fast per user.
model Fast {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  goalHours Int       @map("goal_hours")

  @@index([userId, startedAt])
  @@map("fast")
}

// Steps walked on a day, synced from Health Connect by the app; raises that day's target.
model DailySteps {
  id     Int      @id @default(autoincrement())
  userId Int      @map("user_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  steps  Int

  @@unique([userId, date])
  @@map("daily_steps")
}

// A combination this user logs often ("my breakfast"), added to a meal in one go.
// items: [{ foodId, grams }] or, for quick entries, [{ name, kcal, protein, carbs, fat }].
model SavedMeal {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("saved_meal")
}
